<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.po.User">
        <result property="id" column="id"/>
        <result property="role" column="role"/>
        <result property="name" column="name"/>
        <result property="age" column="age"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="birthdate" column="birthdate"/>
        <result property="photo" column="photo"/>
        <result property="password" column="password"/>
        <result property="userNo" column="user_no"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,role,name,age,phone,email,
        birthdate,photo,password,user_no
    </sql>
    <insert id="registerByPhone">
        insert into user(id, role, name, age, phone, email, birthdate, photo, password,
                         user_no) value (#{id},#{role},#{name},#{age},#{phone},#{email},#{birthdate},#{photo},#{password},#{userNo});
    </insert>
    <insert id="create">
        insert into user(id, role, name, age, phone, email, birthdate, photo, password,
                         user_no) value (#{id},#{role},#{name},#{age},#{phone},#{email},#{birthdate},#{photo},#{password},#{userNo});
    </insert>
    <update id="updatePassword">
        update user
        set password = #{newPwd}
        where id = #{userId}
    </update>
    <update id="update">
        update user
        <set>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="age != null">
                age = #{age},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="email != null and email != ''">
                email = #{email},
            </if>
            <if test="birthdate != null">
                birthdate = #{birthdate},
            </if>
            <if test="photo != null and photo != ''">
                photo = #{photo},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="userNo != null and userNo != ''">
                user_no = #{userNo},
            </if>
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">
        delete
        from user
        where id = #{id}
    </delete>
    <delete id="delete">
        delete from user
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="userNo != null and userNo != ''">
                AND user_no = #{userNo}
            </if>
            <if test="role != null">
                AND role = #{role}
            </if>
            <if test="age != null">
                AND age = #{age}
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
        </where>
    </delete>
    <select id="getMaxId" resultType="java.lang.Long">
        select max(id)
        from user;
    </select>
    <select id="getInfo" resultType="com.example.demo.entity.vo.UserVO">
        SELECT id,
               role,
               name,
               age,
               phone,
               email,
               birthdate,
               photo,
               user_no
        FROM `user`
        WHERE id = #{id}
    </select>
    <select id="getUserById" resultType="com.example.demo.entity.po.User">
        select *
        from user
        where id = #{id}
    </select>
    <select id="getPasswordById" resultType="java.lang.String">
        select password
        from user
        where id = #{id}
    </select>
    <select id="getPasswordByEmail" resultType="java.lang.String">
        select password
        from user
        where email = #{email}
    </select>
    <select id="getPasswordByPhone" resultType="java.lang.String">
        select password
        from user
        where phone = #{phone}
    </select>
    <select id="getIdByEmail" resultType="java.lang.Long">
        select id
        from user
        where email = #{email}
    </select>
    <select id="getIdByPhone" resultType="java.lang.Long">
        select id
        from user
        where phone = #{phone}
    </select>
    <select id="getUserByPhone" resultType="com.example.demo.entity.po.User">
        select *
        from user
        where phone = #{phone}
    </select>
    <select id="getTeacherList" resultType="com.example.demo.entity.vo.TeacherVO">
        select id as teacher_id, name as teacher_name, user_no as teacher_no
        from user
        where role = 2
    </select>
    <select id="select" resultType="com.example.demo.entity.po.User">
        select * from user
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="userNo != null and userNo != ''">
                AND user_no = #{userNo}
            </if>
            <if test="role != null">
                AND role = #{role}
            </if>
            <if test="age != null">
                AND age = #{age}
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="name != null and name != ''">
                AND name = #{name}
            </if>
        </where>
    </select>

</mapper>
