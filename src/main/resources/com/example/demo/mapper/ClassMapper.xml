<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.ClassMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.po.Class">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="college" column="college"/>
        <result property="major" column="major"/>
        <result property="classNo" column="class_no"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,user_id,college,major,class_no
    </sql>
    <insert id="add">
        insert into class value (#{id},#{userId},#{college},#{major},#{classNo} )
    </insert>
    <update id="update">
        update class
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="college != null and college !=''">
                college=#{college},
            </if>
            <if test="major != null and major != ''">
                major=#{major},
            </if>
            <if test="classNo != null and classNo != '' ">
                class_no=#{classNo}
            </if>
        </set>
        where id = #{id}
    </update>
    <delete id="deleteById">
        delete
        from class
        where id = #{id}
    </delete>
    <select id="getMaxId" resultType="java.lang.Long">
        select max(id)
        from class
    </select>
    <select id="getInfo" resultType="com.example.demo.entity.vo.ClassVO">
        select user_id, college, major, class_no
        from class
        where id = #{id}
    </select>
    <select id="getPage" resultType="com.example.demo.entity.vo.ClassVO">
        select c.*, u.name as user_name, u.user_no
        from class c
                 left join user u on c.user_id = u.id
        order by id desc limit #{offset}, #{pageSize}
    </select>
    <select id="getCount" resultType="java.lang.Long">
        select count(*)
        from class
    </select>
</mapper>
